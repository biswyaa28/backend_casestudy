{
  "info": {
    "name": "Warehouse Stock Transfer API",
    "description": "Collection for the Warehouse Stock Transfer Management case study API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001/api" },
    { "key": "token", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "warehouseId", "value": "" },
    { "key": "warehouse2Id", "value": "" },
    { "key": "transferId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register staff",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Staff One\",\n  \"email\": \"staff1@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"staff\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Public. Anyone can register a staff account."
          },
          "response": []
        },
        {
          "name": "Register manager",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manager One\",\n  \"email\": \"manager1@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"manager\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "description": "Public. Anyone can register a manager account."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the returned JWT into the collection variable {{token}}",
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set(\"token\", data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager1@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Public. Logs in and saves the JWT token into {{token}} automatically."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "Create warehouse",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main Warehouse\",\n  \"location\": \"Kolkata\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/warehouses", "host": ["{{baseUrl}}"], "path": ["warehouses"] },
            "description": "Manager only. Creates a new warehouse."
          },
          "response": []
        },
        {
          "name": "Get all warehouses",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/warehouses", "host": ["{{baseUrl}}"], "path": ["warehouses"] },
            "description": "Any logged-in user. Lists all warehouses."
          },
          "response": []
        },
        {
          "name": "Get one warehouse",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/warehouses/{{warehouseId}}", "host": ["{{baseUrl}}"], "path": ["warehouses", "{{warehouseId}}"] },
            "description": "Any logged-in user. Gets one warehouse by id."
          },
          "response": []
        },
        {
          "name": "Update warehouse",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main Warehouse (Updated)\",\n  \"location\": \"Kolkata\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/warehouses/{{warehouseId}}", "host": ["{{baseUrl}}"], "path": ["warehouses", "{{warehouseId}}"] },
            "description": "Manager only. Fully replaces a warehouse's name and location."
          },
          "response": []
        },
        {
          "name": "Delete warehouse",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/warehouses/{{warehouseId}}", "host": ["{{baseUrl}}"], "path": ["warehouses", "{{warehouseId}}"] },
            "description": "Manager only. Deletes a warehouse."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Steel Rod\",\n  \"sku\": \"SKU-001\",\n  \"stock\": [\n    { \"warehouse\": \"{{warehouseId}}\", \"quantity\": 100 },\n    { \"warehouse\": \"{{warehouse2Id}}\", \"quantity\": 0 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "description": "Manager only. Creates a product with a starting stock array."
          },
          "response": []
        },
        {
          "name": "Get all products",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "description": "Any logged-in user. Lists all products with warehouse names populated in stock."
          },
          "response": []
        },
        {
          "name": "Get one product",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] },
            "description": "Any logged-in user. Gets one product by id."
          },
          "response": []
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Steel Rod\",\n  \"sku\": \"SKU-001\",\n  \"stock\": [\n    { \"warehouse\": \"{{warehouseId}}\", \"quantity\": 80 },\n    { \"warehouse\": \"{{warehouse2Id}}\", \"quantity\": 20 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] },
            "description": "Manager only. Fully replaces a product's name, sku and stock array."
          },
          "response": []
        },
        {
          "name": "Delete product",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] },
            "description": "Manager only. Deletes a product."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Create transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"{{productId}}\",\n  \"fromWarehouse\": \"{{warehouseId}}\",\n  \"toWarehouse\": \"{{warehouse2Id}}\",\n  \"quantity\": 10\n}"
            },
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] },
            "description": "Any logged-in user. Requests a stock transfer. Starts as pending."
          },
          "response": []
        },
        {
          "name": "Get all transfers",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/transfers", "host": ["{{baseUrl}}"], "path": ["transfers"] },
            "description": "Any logged-in user. Lists all transfers."
          },
          "response": []
        },
        {
          "name": "Get pending transfers",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": {
              "raw": "{{baseUrl}}/transfers?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["transfers"],
              "query": [ { "key": "status", "value": "pending" } ]
            },
            "description": "Any logged-in user. Lists only transfers with status pending."
          },
          "response": []
        },
        {
          "name": "Approve transfer",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/transfers/{{transferId}}/approve", "host": ["{{baseUrl}}"], "path": ["transfers", "{{transferId}}", "approve"] },
            "description": "Manager only. Approves a pending transfer and moves stock between warehouses."
          },
          "response": []
        },
        {
          "name": "Reject transfer",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/transfers/{{transferId}}/reject", "host": ["{{baseUrl}}"], "path": ["transfers", "{{transferId}}", "reject"] },
            "description": "Manager only. Rejects a pending transfer. No stock is moved."
          },
          "response": []
        }
      ]
    }
  ]
}
